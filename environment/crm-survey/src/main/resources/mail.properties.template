# ================= SMTP 发信配置模板 =================
# 用法: 复制本文件为 mail.properties (与 template 同目录) 并填入真值。
# mail.properties 不入库, 真值只在各自机器上。

mail.smtp.host=smtp.126.com
mail.smtp.port=465
mail.smtp.auth=true
mail.smtp.user=你的邮箱@126.com
mail.smtp.password=这里填授权码
mail.smtp.ssl=true
mail.smtp.starttls.enable=false
# 网易系 SMTP 和新 JDK 的 TLS1.3 hello 犯冲, 钉死 1.2 (实测必配)
mail.smtp.ssl.protocols=TLSv1.2

# 发件人必须和登录账号一致, 否则 126 直接拒信
mail.from=你的邮箱@126.com

# 发出的邮件留档目录 (当年邮件网关扫盘的老习惯, 现在留个底)
mail.spool.dir=/opt/crm/mail

# 邮件里链接的对外地址 (含 war 的 context path)
mail.base.url=http://localhost:8080/crm-survey
