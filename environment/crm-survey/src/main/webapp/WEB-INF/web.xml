<?xml version="1.0" encoding="UTF-8"?>
<!-- 2016 年随 Tomcat 8.5 升级到 3.1 schema, 配置还是老写法, 没改注解 -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- 编码过滤器必须排第一, 在任何参数被解析之前生效 -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>com.legacy.survey.web.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>csrfFilter</filter-name>
        <filter-class>com.legacy.survey.web.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>csrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 后台管理页面的登录检查 -->
    <filter>
        <filter-name>loginCheckFilter</filter-name>
        <filter-class>com.legacy.survey.web.LoginCheckFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>loginCheckFilter</filter-name>
        <url-pattern>/user.do</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>loginCheckFilter</filter-name>
        <url-pattern>/index.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>loginCheckFilter</filter-name>
        <url-pattern>/question.do</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>loginCheckFilter</filter-name>
        <url-pattern>/survey.do</url-pattern>
    </filter-mapping>

    <!-- Tomcat 起来时拉起定时任务: 每分钟扫一次调查任务表 -->
    <listener>
        <listener-class>com.legacy.survey.task.SurveyTaskSchedulerListener</listener-class>
    </listener>

    <!-- Struts 1.3 总入口, 所有 .do 都归它管 -->
    <servlet>
        <servlet-name>action</servlet-name>
        <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
        <init-param>
            <param-name>config</param-name>
            <param-value>/WEB-INF/struts-config.xml</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>action</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>

    <!-- 统一错误出口 (受访者看到的就是这一张脸) -->
    <error-page>
        <error-code>500</error-code>
        <location>/global_error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/global_error.jsp</location>
    </error-page>

    <welcome-file-list>
        <welcome-file>survey_config.jsp</welcome-file>
    </welcome-file-list>

</web-app>
