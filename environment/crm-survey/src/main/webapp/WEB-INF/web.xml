<?xml version="1.0" encoding="UTF-8"?>
<!-- 2016 年随 Tomcat 8.5 升级到 3.1 schema, 配置还是老写法, 没改注解 -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <filter>
        <filter-name>csrfFilter</filter-name>
        <filter-class>com.legacy.survey.web.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>csrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>surveyConfig</servlet-name>
        <servlet-class>com.legacy.survey.web.SurveyConfigServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>surveyConfig</servlet-name>
        <url-pattern>/surveyConfig.do</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>survey_config.jsp</welcome-file>
    </welcome-file-list>

</web-app>
