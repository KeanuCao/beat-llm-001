<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.legacy.survey.dao.SurveyMapper">

    <select id="selectAll" resultType="com.legacy.survey.pojo.Survey">
        SELECT * FROM `survey`
        WHERE `is_deleted` = 0
        ORDER BY `id` DESC
    </select>

    <select id="selectById" resultType="com.legacy.survey.pojo.Survey">
        SELECT * FROM `survey` WHERE `id` = #{id} AND `is_deleted` = 0
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `survey` (`title`, `description`, `status`, `creator_id`, `publish_time`, `is_deleted`, `create_time`, `update_time`)
        VALUES (#{title}, #{description}, #{status}, #{creatorId}, #{publishTime}, 0, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE `survey` SET `title` = #{title}, `description` = #{description}, `status` = #{status}, `update_time` = NOW()
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>

    <update id="updateStatus">
        UPDATE `survey`
        <set>
            `status` = #{status},
            <if test="publishTime != null">`publish_time` = #{publishTime},</if>
            `update_time` = NOW()
        </set>
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>

    <update id="logicalDelete">
        UPDATE `survey` SET `is_deleted` = 1, `update_time` = NOW() WHERE `id` = #{id} AND `is_deleted` = 0
    </update>

</mapper>
